# Copy to backend/.env. Real environment variables override this file.
PORT=4000
DATABASE_URL=postgres://flash:flash@localhost:5433/flashsale

# Reservation lifetime before it can be expired (seconds).
RESERVATION_TTL_SECONDS=120

# 1 enables POST /api/dev/reset (tests/demo only). Never enable in production.
ALLOW_DEV_RESET=0

# Connection pool and bounded waits (busy -> 503 + Retry-After instead of hanging).
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
